# Copia este archivo como backend/.env (sin .example) y reemplaza los valores.
# Datos en Supabase: boton "Connect" > tipo "JDBC" > metodo "Session pooler".
# De la cadena que te da Supabase:
#   DB_URL      = todo hasta "/postgres", mas ?sslmode=require (sin user ni password)
#   DB_USERNAME = lo que va despues de "user="  (empieza por postgres.)
#   DB_PASSWORD = la clave que pusiste al crear el proyecto
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.abcdefghijklmnop
DB_PASSWORD=TuClaveSinSimbolos123

# Si al arrancar sale "Read timed out" o "Connection reset", tu red bloquea el puerto 5432.
# Usa el puerto 6543 (Transaction pooler) con prepareThreshold=0, que Hibernate necesita en ese modo:
# DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
