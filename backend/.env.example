# Copia este archivo como backend/.env (sin .example) y reemplaza los valores.
# Datos en Supabase: boton "Connect" > tipo "JDBC" > metodo "Session pooler".
# De la cadena que te da Supabase:
#   DB_URL      = todo hasta "/postgres", mas ?sslmode=require (sin user ni password)
#   DB_USERNAME = lo que va despues de "user="  (empieza por postgres.)
#   DB_PASSWORD = la clave que pusiste al crear el proyecto
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.abcdefghijklmnop
DB_PASSWORD=TuClaveSinSimbolos123

# Si al arrancar sale "Read timed out" o "Connection reset", tu red bloquea el puerto 5432.
# Usa el puerto 6543 (Transaction pooler) con prepareThreshold=0, que Hibernate necesita en ese modo:
# DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0

# --- Correo (codigos de verificacion, avisos de reservas y de login bloqueado) ---
# Con APP_MAIL_ENABLED=false los codigos solo se escriben en la consola del backend.
# Opcion A, en tu PC: Gmail por SMTP. SPRING_MAIL_PASSWORD es una "contrasena de aplicacion"
# (Cuenta de Google > Seguridad), nunca la contrasena normal de la cuenta.
# Opcion B, en Render (bloquea SMTP en el plan gratuito): API de Brevo. Si BREVO_API_KEY tiene valor,
# se usa Brevo en lugar de SMTP. MAIL_FROM debe ser un remitente verificado en tu cuenta de Brevo.
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-correo@gmail.com
SPRING_MAIL_PASSWORD=contrasena-de-aplicacion-de-16-letras
BREVO_API_KEY=
MAIL_FROM=tu-correo@gmail.com
MAIL_FROM_NAME=ProMarket

# reCAPTCHA v2 (Google) — SECRET KEY privada, solo backend
RECAPTCHA_SECRET_KEY=
